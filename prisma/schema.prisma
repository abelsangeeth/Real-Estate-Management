datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("buyer") // admin, agent, buyer
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  inquiries Inquiry[]
}

model Listing {
  id          String   @id @default(uuid())
  title       String
  description String
  price       Float
  location    String
  bedrooms    Int
  bathrooms   Float
  areaSqFt    Float
  imageUrl    String
  isFeatured  Boolean  @default(false)
  amenities   String   // Comma-separated: "infinity pool, helipad, private dock"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  inquiries   Inquiry[]
}

model Inquiry {
  id                String   @id @default(uuid())
  clientName        String
  clientEmail       String
  clientPhone       String
  message           String
  requestedTourDate String?
  listingId         String
  listing           Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  userId            String?
  user              User?    @relation(fields: [userId], references: [id])
  createdAt         DateTime @default(now())
}
